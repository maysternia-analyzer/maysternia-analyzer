# Майстерня скілів — Аналізатор записів
# Скопіюйте цей файл як .env і заповніть значення. .env НЕ комітиться в git.

# ── Обовʼязкові ────────────────────────────────────────────────────────────────
# Anthropic Claude — AI-аналіз транскрипцій (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Секретний ключ сесій Flask: довгий випадковий рядок, унікальний для кожного середовища.
# Згенерувати: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# ── Необовʼязкові ──────────────────────────────────────────────────────────────
# Модель Claude (за замовчуванням claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI — транскрипція аудіо/відео через Whisper (не потрібна для VTT/TXT і Zoom-транскрипцій)
# OPENAI_API_KEY=sk-...
# WHISPER_LANGUAGE=uk

# Zoom Server-to-Server OAuth (автоматичний імпорт записів). Без них — лише ручне завантаження.
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_WEBHOOK_SECRET=

# PostgreSQL (на Railway задається автоматично). Без нього — локальна SQLite data.db
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Тонке налаштування (значення за замовчуванням)
# APP_TIMEZONE=Europe/Kyiv
# ZOOM_POLL_INTERVAL_MINUTES=5
# ZOOM_POLL_LOOKBACK_DAYS=3
# ZOOM_MIN_DURATION_MINUTES=3
# ZOOM_TRANSCRIPT_WAIT_MINUTES=180
# ZOOM_IGNORE_SPEAKERS=Код Харизми
# JOB_CONCURRENCY=2
# JOB_MAX_ATTEMPTS=3
# LOG_LEVEL=INFO
